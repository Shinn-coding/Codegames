# Copy this file to .env and fill every blank value.
# Generate AUTH_SECRET and LICENSE_HMAC_SECRET with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Prisma dev / Neon)
# Prisma dev: DATABASE_URL = prisma+postgres proxy; DIRECT_URL = TCP with pgbouncer=true.
DATABASE_URL=
DIRECT_URL=

# Auth
AUTH_URL=http://localhost:3000
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ADMIN_EMAILS=admin@local.test

# Demo auth (never enable in production)
DEV_AUTH=true

# Payment / email / storage
PAYMENT_PROVIDER=mock
EMAIL_PROVIDER=console
EMAIL_FROM=CodeGems <noreply@example.com>
LICENSE_HMAC_SECRET=
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage

# Optional providers (mock/local defaults are used in demo mode)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
RESEND_API_KEY=
BLOB_READ_WRITE_TOKEN=

# Integration tests reuse DATABASE_URL. Never point this file at a production
# database while running them.
